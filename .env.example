# =============================================================================
# L9 Tools — environment variables
# Copy this file to `.env.local` and fill in your values.
# https://nextjs.org/docs/app/building-your-application/configuring/environment-variables
# =============================================================================

# --- Required (local dev) ----------------------------------------------------

# Supabase — Project Settings → API
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose in the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (OAuth redirect base). Local dev uses port 9002 (`npm run dev`)
NEXT_PUBLIC_SITE_URL=http://localhost:9002

# --- PayMongo (subscriptions / payments) -------------------------------------

NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=pk_test_your_public_key
PAYMONGO_SECRET_KEY=sk_test_your_secret_key
PAYMONGO_WEBHOOK_SECRET=whsec_your_webhook_secret

# --- Resend (email) ----------------------------------------------------------

RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=L9 Tools <noreply@yourdomain.com>
RESEND_REPLY_TO=support@yourdomain.com
RESEND_RECEIVING_EMAIL=contact@yourdomain.com
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret

# HMAC secret for signed email unsubscribe links (falls back to SUPABASE_SERVICE_ROLE_KEY)
UNSUBSCRIBE_TOKEN_SECRET=your-unsubscribe-signing-secret
